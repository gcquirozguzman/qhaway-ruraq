# Copia este archivo como .env y completa los valores.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Zoom Server-to-Server OAuth (opcional, solo para grabaciones de tu propia cuenta)
# Crea la app en https://marketplace.zoom.us/ -> Develop -> Build App -> Server-to-Server OAuth
# Scopes: cloud_recording:read:list_user_recordings:admin, cloud_recording:read:list_recording_files:admin
#         (o los equivalentes cloud_recording:read:admin / recording:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Usuario cuyas grabaciones se listan con "qhaway zoom --listar" (email, id o "me")
ZOOM_USER_ID=me
